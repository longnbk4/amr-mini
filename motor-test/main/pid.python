#!/usr/bin/env python3
import serial
import threading
import sys
import time

# ==================== CẤU HÌNH ====================
PORT = '/dev/serial0'          
BAUD_RATE = 115200
DEFAULT_SPEED = 160            

# Biến toàn cục lưu tốc độ
current_left = 0
current_right = 0
is_running = True

def read_from_esp(ser):
    count = 0
    while is_running:
        try:
            if ser.in_waiting > 0:
                line = ser.readline().decode('utf-8', errors='ignore').strip()
                if line.startswith('E,'):
                    count += 1
                    # CHỈ IN RA 1 LẦN SAU MỖI 10 LẦN ĐỌC (Tránh treo Terminal)
                    # Giúp giải phóng CPU cho luồng truyền lệnh
                    if count % 10 == 0:
                        print(f"\r[Encoder] {line}          ", end='', flush=True)
        except Exception as e:
            if is_running: print(f"\n[Lỗi đọc] {e}")
            break
        
        # Ngủ một chút để nhường CPU cho luồng keep_alive_sender
        time.sleep(0.005) 

def keep_alive_sender(ser):
    """Gửi lệnh vận tốc liên tục ở tần số 10Hz để nuôi Timeout trên ESP32"""
    while is_running:
        try:
            packet = f"V,{current_left},{current_right}\n"
            ser.write(packet.encode())
            time.sleep(0.1) # 100ms
        except:
            break

def main():
    global current_left, current_right, is_running
    try:
        # Thêm timeout=0.1 để hàm readline không bị kẹt vĩnh viễn nếu mất kết nối
        ser = serial.Serial(PORT, BAUD_RATE, timeout=0.1)
        print(f"[*] Đã kết nối ESP32 qua {PORT}")
    except Exception as e:
        print(f"[!] Không mở được cổng {PORT}\nLỗi: {e}")
        sys.exit(1)

    # Khởi động các luồng chạy nền
    t_read = threading.Thread(target=read_from_esp, args=(ser,), daemon=True)
    t_read.start()

    t_send = threading.Thread(target=keep_alive_sender, args=(ser,), daemon=True)
    t_send.start()

    print("\n" + "="*40)
    print("  ĐIỀU KHIỂN ROBOT QUA UART (ĐÃ FIX DELAY)")
    print("="*40)
    print("  W : Tiến          S : Lùi")
    print("  A : Xoay trái     D : Xoay phải")
    print("  X : Dừng")
    print("  Hoặc gõ trực tiếp: 30,30 (Ticks/50ms)")
    print("  Ctrl+C để thoát\n")

    try:
        while True:
            # Nhận phím từ người dùng (cần bấm Enter)
            cmd = input("").strip().upper() 

            if cmd == 'W':
                current_left, current_right = DEFAULT_SPEED, DEFAULT_SPEED
            elif cmd == 'S':
                current_left, current_right = -DEFAULT_SPEED, -DEFAULT_SPEED
            elif cmd == 'A':
                current_left, current_right = -DEFAULT_SPEED, DEFAULT_SPEED
            elif cmd == 'D':
                current_left, current_right = DEFAULT_SPEED, -DEFAULT_SPEED
            elif cmd == 'X':
                current_left, current_right = 0, 0
            elif ',' in cmd:
                try:
                    parts = cmd.split(',')
                    current_left = int(parts[0].strip())
                    current_right = int(parts[1].strip())
                except:
                    print("\n[!] Sai cú pháp. Ví dụ: 30,-30")
            elif cmd != '':
                print("\n[!] Lệnh không hợp lệ")

    except KeyboardInterrupt:
        print("\n[*] Dừng khẩn cấp...")
        is_running = False
        ser.write(b"V,0,0\n")
        time.sleep(0.2)
        ser.close()
        print("[*] Đã thoát.")

if __name__ == '__main__':
    main()