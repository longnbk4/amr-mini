#!/usr/bin/env python3
import serial
import threading
import sys
import time

# ==================== CẤU HÌNH ====================
PORT = '/dev/serial0'          
BAUD_RATE = 115200
DEFAULT_SPEED = 200           

# Biến toàn cục lưu tốc độ để gửi liên tục
current_left = 0
current_right = 0
is_running = True

def read_from_esp(ser):
    while is_running:
        try:
            if ser.in_waiting > 0:
                line = ser.readline().decode('utf-8', errors='ignore').strip()
                if line.startswith('E,'):
                    print(f"\r[Encoder] {line}          ", end='', flush=True)
        except Exception as e:
            if is_running: print(f"\n[Lỗi đọc] {e}")
            break

def keep_alive_sender(ser):
    """Gửi lệnh vận tốc liên tục ở tần số 10Hz để nuôi Timeout trên ESP32"""
    while is_running:
        try:
            packet = f"V,{current_left},{current_right}\n"
            ser.write(packet.encode())
            time.sleep(0.1) # 100ms
        except:
            break

def main():
    global current_left, current_right, is_running
    try:
        ser = serial.Serial(PORT, BAUD_RATE, timeout=0.5)
        print(f"[*] Đã kết nối ESP32 qua {PORT}")
    except Exception as e:
        print(f"[!] Không mở được cổng {PORT}\nLỗi: {e}")
        sys.exit(1)

    # Thread 1: Đọc encoder liên tục
    t_read = threading.Thread(target=read_from_esp, args=(ser,), daemon=True)
    t_read.start()

    # Thread 2: Gửi lệnh PWM liên tục (Keep-alive)
    t_send = threading.Thread(target=keep_alive_sender, args=(ser,), daemon=True)
    t_send.start()

    print("\n" + "="*40)
    print("  ĐIỀU KHIỂN ROBOT QUA UART (KEEP-ALIVE)")
    print("="*40)
    print("  W : Tiến          S : Lùi")
    print("  A : Xoay trái     D : Xoay phải")
    print("  X : Dừng")
    print("  Hoặc gõ trực tiếp: 150,150")
    print("  Ctrl+C để thoát\n")

    try:
        while True:
            cmd = input("").strip().upper() # Ẩn text "Lệnh >" để màn hình đỡ rối

            if cmd == 'W':
                current_left, current_right = DEFAULT_SPEED, DEFAULT_SPEED
            elif cmd == 'S':
                current_left, current_right = -DEFAULT_SPEED, -DEFAULT_SPEED
            elif cmd == 'A':
                current_left, current_right = -DEFAULT_SPEED, DEFAULT_SPEED
            elif cmd == 'D':
                current_left, current_right = DEFAULT_SPEED, -DEFAULT_SPEED
            elif cmd == 'X':
                current_left, current_right = 0, 0
            elif ',' in cmd:
                try:
                    parts = cmd.split(',')
                    current_left = int(parts[0].strip())
                    current_right = int(parts[1].strip())
                except:
                    print("\n[!] Sai cú pháp. Ví dụ: 120,-80")
            elif cmd != '':
                print("\n[!] Lệnh không hợp lệ")

    except KeyboardInterrupt:
        print("\n[*] Dừng khẩn cấp...")
        is_running = False
        ser.write(b"V,0,0\n")
        time.sleep(0.2)
        ser.close()
        print("[*] Đã thoát.")

if __name__ == '__main__':
    main()