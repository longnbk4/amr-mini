#!/usr/bin/env python3
import serial
import threading
import sys
import time

PORT = '/dev/serial0'
BAUD_RATE = 115200
DEFAULT_SPEED = 160

current_left = 0
current_right = 0
is_running = True

def read_from_esp(ser):
    count = 0
    while is_running:
        try:
            if ser.in_waiting > 0:
                line = ser.readline().decode('utf-8', errors='ignore').strip()
                if line.startswith('E,'):
                    count += 1
                    if count % 5 == 0:
                        parts = line[2:].split(',')
                        if len(parts) >= 7:
                            print(f"\rRPM L:{parts[2]:>6} R:{parts[3]:>6} | "
                                  f"x:{parts[4]:>7} y:{parts[5]:>7} θ:{parts[6]:>7}° | "
                                  f"Ticks L:{parts[0]:>6} R:{parts[1]:>6}  ", end='', flush=True)
                elif line == "OK":
                    pass  # nhận được phản hồi OK từ ESP
        except Exception as e:
            if is_running:
                print(f"\n[Lỗi đọc] {e}")
            break
        time.sleep(0.002)

def keep_alive_sender(ser):
    while is_running:
        try:
            packet = f"V,{current_left},{current_right}\n"
            ser.write(packet.encode())
            time.sleep(0.08)   # ~12.5 Hz
        except:
            break

def main():
    global current_left, current_right, is_running

    try:
        ser = serial.Serial(PORT, BAUD_RATE, timeout=0.1)
        print(f"[*] Đã kết nối ESP32 qua {PORT}")
    except Exception as e:
        print(f"[!] Không mở được {PORT}: {e}")
        sys.exit(1)

    t_read = threading.Thread(target=read_from_esp, args=(ser,), daemon=True)
    t_read.start()
    t_send = threading.Thread(target=keep_alive_sender, args=(ser,), daemon=True)
    t_send.start()

    print("\n" + "="*55)
    print("  ĐIỀU KHIỂN ROBOT + ODOMETRY (Encoder x2)")
    print("="*55)
    print("  W/S/A/D  : Tiến / Lùi / Trái / Phải")
    print("  X        : Dừng")
    print("  R        : Reset odometry")
    print("  120,120  : Gõ tốc độ tùy ý (PWM)")
    print("  Ctrl+C   : Thoát")
    print("="*55 + "\n")

    try:
        while True:
            cmd = input("").strip().upper()
            if cmd == 'W':
                current_left = current_right = DEFAULT_SPEED
            elif cmd == 'S':
                current_left = current_right = -DEFAULT_SPEED
            elif cmd == 'A':
                current_left, current_right = -DEFAULT_SPEED, DEFAULT_SPEED
            elif cmd == 'D':
                current_left, current_right = DEFAULT_SPEED, -DEFAULT_SPEED
            elif cmd == 'X':
                current_left = current_right = 0
            elif cmd == 'R':
                ser.write(b"R\n")
                print("\n→ Đã gửi lệnh RESET ODOMETRY")
            elif ',' in cmd:
                try:
                    parts = cmd.split(',')
                    current_left  = int(parts[0].strip())
                    current_right = int(parts[1].strip())
                except:
                    print("\n[!] Sai cú pháp. Ví dụ: 150,150")
            elif cmd != '':
                print("\n[!] Lệnh không hợp lệ")
    except KeyboardInterrupt:
        print("\n[*] Dừng...")
        is_running = False
        ser.write(b"V,0,0\n")
        time.sleep(0.15)
        ser.close()
        print("[*] Đã thoát.")

if __name__ == '__main__':
    main()